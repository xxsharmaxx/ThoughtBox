# ThoughtBox Environment Configuration
# Copy this file to .env and customize the values

# PostgreSQL
POSTGRES_USER=thoughtbox
POSTGRES_PASSWORD=thoughtbox
POSTGRES_DB=thoughtbox

# Moderator secret — change this to a strong, unique value
MODERATOR_SECRET=change-me-in-production

# Frontend API URL — the URL the browser uses to reach the backend
# For local Docker: http://localhost:8000
VITE_API_URL=http://localhost:8000
